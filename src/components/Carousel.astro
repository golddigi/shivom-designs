---
const { label, variant = 'cards' } = Astro.props;
---
<div class:list={['carousel', `carousel-${variant}`]} data-carousel>
  <div class="carousel-track" role="region" aria-label={label} tabindex="0" data-carousel-track>
    <slot />
  </div>
  <div class="carousel-controls" data-carousel-controls hidden>
    <button type="button" aria-label={`Previous ${label.toLowerCase()}`} data-carousel-step="-1"><span aria-hidden="true">‹</span></button>
    <button type="button" aria-label={`Next ${label.toLowerCase()}`} data-carousel-step="1"><span aria-hidden="true">›</span></button>
  </div>
</div>
