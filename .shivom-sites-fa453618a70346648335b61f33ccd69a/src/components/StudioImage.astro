---
import { sitePath } from '../lib/paths.js';
import { images } from '../data/studio.js';

const { name, alt, shape = 'portrait', eager = false, sizes = '(max-width: 767px) 90vw, (max-width: 991px) 42vw, 570px', class: extraClass } = Astro.props;
const image = images[name];
const source = (width) => sitePath(`assets/interiors/${name}-${width}.webp`);
---

<div class:list={['image-slot', extraClass]}>
  <div class="image-reveal" data-reveal={eager ? undefined : ''}>
    <div class:list={['image-frame', `image-${shape}`]} data-drift>
      <img
        src={source(image.widths.at(-1))}
        srcset={image.widths.map((width) => `${source(width)} ${width}w`).join(', ')}
        {sizes}
        alt={alt ?? image.alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        style={`object-position:${image.focus ?? 'center'}`}
      />
    </div>
  </div>
</div>
