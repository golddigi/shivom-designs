---
<dialog class="film-dialog" data-film-dialog aria-labelledby="film-title">
  <div class="film-dialog-inner">
    <div class="film-dialog-heading">
      <div>
        <h2 id="film-title" data-film-name></h2>
        <p data-film-source></p>
      </div>
      <form method="dialog"><button type="submit" aria-label="Close film" autofocus>×</button></form>
    </div>
    <div class="film-player" data-film-player></div>
    <a class="film-external" data-film-external target="_blank" rel="noopener noreferrer">Watch on YouTube</a>
  </div>
</dialog>
